# Google AI Studio key — grab a free one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=...
TAVILY_API_KEY=...

# Client-side pacing for model calls. The Gemini free tier allows 15
# requests/minute/model and one run makes ~20, so calls are spaced out rather
# than rate-limited mid-run. Raise it on a paid key; 0 turns it off.
MAX_REQUESTS_PER_MINUTE=12

# Langfuse tracing — optional. Leave these blank and the run works exactly as
# before, just unobserved. Free project at https://cloud.langfuse.com, then
# Settings > API Keys. Both keys are needed; one alone disables tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU region. US projects use https://us.cloud.langfuse.com; self-hosted, your
# own URL. (v4 renamed this from LANGFUSE_HOST.)
LANGFUSE_BASE_URL=https://cloud.langfuse.com
