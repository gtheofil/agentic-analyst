# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Virtual envs ---
.venv/
venv/
env/

# --- Environment / secrets ---
.env
.env.local
*.pem
*.key

# --- Project-specific ---
reports/*
!reports/.gitkeep
runs/
*.log

# CI's eval output. `evals/results/summary.md` *is* committed — it is the
# results table the README quotes — but a per-PR sweep is an artifact, not a
# result, and committing it would make every eval run a diff.
evals/results/ci/

# What the agent writes about itself (the Chroma store). Machine-generated and
# machine-readable, and it embeds the content of past runs — config/prefs.yaml
# is the human-authored half and *is* committed.
data/

# --- Personal notes, never pushed ---
.local/

# --- IDE ---
.vscode/
.idea/
*.swp
.DS_Store
